# Copy to .env (git ignores it). Keys stay on your computer.

# Google AI Studio > Get API key
GEMINI_API_KEY=
# Model id and prices in dollars per million tokens (check https://ai.google.dev/gemini-api/docs/pricing)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_PRICE_IN=1.5
GEMINI_PRICE_OUT=9

# console.anthropic.com > API keys
ANTHROPIC_API_KEY=
# Model id and prices in dollars per million tokens (check https://claude.com/pricing)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_PRICE_IN=4
CLAUDE_PRICE_OUT=20
CLAUDE_EFFORT=medium
