rules_version = '2';

// RecipeSave keeps no recipe data on the server. Firestore only holds the free-scan config and
// spend totals, which the freeScan Cloud Function reads and writes with admin access.
// The app itself never reads or writes Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
